# Copy this to .env.local and fill in your values.
# .env.local is gitignored.

# Required: Google AI Studio key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model (defaults to gemini-3-pro-image-preview).
GEMINI_MODEL_ID=gemini-3-pro-image-preview

# Optional: recipient for the Learning & Improvement mailto: link.
# Exposed to the client at build time — must use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_FEEDBACK_RECIPIENT_EMAIL=

# Optional: max upload size in bytes. Defaults to 25 MB.
MAX_UPLOAD_BYTES=26214400
